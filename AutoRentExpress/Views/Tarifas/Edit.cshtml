@model AutoRentExpress.DTOs.TarifaDto
@using System.Globalization

@{
    ViewData["Title"] = "Editar Tarifa";

    var categorias = ViewBag.Categorias as List<AutoRentExpress.DTOs.TarifaCategoriaDto>
        ?? new List<AutoRentExpress.DTOs.TarifaCategoriaDto>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Editar Tarifa</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Tarifas"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CategoriaVehiculoId" class="form-label">
                                    Categoría de vehículo
                                </label>

                                <select asp-for="CategoriaVehiculoId"
                                        class="form-select"
                                        required>
                                    <option value="0">Selecciona una categoría</option>

                                    @foreach (var categoria in categorias)
                                    {
                                        <option value="@categoria.Id">
                                            @categoria.Nombre
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="CategoriaVehiculoId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PrecioDiario" class="form-label">
                                    Precio diario ($)
                                </label>

                                <input name="PrecioDiario"
                                       type="number"
                                       min="0.01"
                                       max="1000000"
                                       step="0.01"
                                       value="@Model.PrecioDiario.ToString("0.00", CultureInfo.InvariantCulture)"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="PrecioDiario"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VigenteDesde" class="form-label">
                                    Vigente desde
                                </label>

                                <input asp-for="VigenteDesde"
                                       asp-format="{0:yyyy-MM-dd}"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="VigenteDesde"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VigenteHasta" class="form-label">
                                    Vigente hasta
                                </label>

                                <input asp-for="VigenteHasta"
                                       asp-format="{0:yyyy-MM-dd}"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="VigenteHasta"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Tarifas"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
