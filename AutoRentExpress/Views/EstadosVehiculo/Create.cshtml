@model AutoRentExpress.DTOs.EstadoVehiculoDto

@{
    ViewData["Title"] = "Nuevo Estado";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Registrar Estado de Vehículo</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="EstadosVehiculo"
                          asp-action="Create"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre"
                                   class="form-label">
                                Nombre del estado
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ejemplo: Disponible"
                                   maxlength="100" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="EstadosVehiculo"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar Estado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}