@model List<AutoRentExpress.DTOs.ModeloDto>

@{
    ViewData["Title"] = "Modelos";
    var marcas = ViewBag.Marcas as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Gestión de Modelos</h2>
            <p class="text-muted">Modelos de vehículos por marca</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Modelo</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-muted">Total de modelos</h6>
            <h2 class="fw-bold">@Model.Count</h2>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var modelo in Model)
                        {
                            <tr>
                                <td>@modelo.Id</td>
                                <td>@modelo.NombreMarca</td>
                                <td>@modelo.Nombre</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editarModelo-@modelo.Id">
                                        Editar
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#eliminarModelo-@modelo.Id">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-center text-muted py-3">
                    Todavía no hay modelos registrados.
                </p>
            }
        </div>
    </div>
</div>

@foreach (var modelo in Model)
{
    <div class="modal fade" id="editarModelo-@modelo.Id"
         tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Editar Modelo</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@modelo.Id" />

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label">Marca</label>
                            <select name="MarcaId" class="form-select" required>
                                @if (marcas != null)
                                {
                                    @foreach (var marca in marcas)
                                    {
                                        if (marca.Value == modelo.MarcaId.ToString())
                                        {
                                            <option value="@marca.Value" selected>@marca.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@marca.Value">@marca.Text</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Modelo</label>
                            <input name="Nombre"
                                   value="@modelo.Nombre"
                                   class="form-control"
                                   maxlength="100"
                                   required />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="eliminarModelo-@modelo.Id"
         tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Eliminar Modelo</h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4 text-center">
                    <h5>¿Deseas eliminar este modelo?</h5>
                    <p class="fw-bold mt-3">@modelo.NombreMarca @modelo.Nombre</p>
                    <p class="text-muted">
                        No se podrá eliminar si tiene vehículos asociados.
                    </p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@modelo.Id" />
                        <button type="submit" class="btn btn-danger">
                            Sí, eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}