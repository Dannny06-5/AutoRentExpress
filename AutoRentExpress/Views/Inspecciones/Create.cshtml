@model AutoRentExpress.DTOs.InspeccionDto

@{
    ViewData["Title"] = "Nueva Inspección";

    var catalogos = ViewBag.Catalogos as AutoRentExpress.DTOs.InspeccionCatalogosDto
        ?? new AutoRentExpress.DTOs.InspeccionCatalogosDto();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Registrar Nueva Inspección</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Inspecciones"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ContratoId" class="form-label">
                                    Contrato
                                </label>

                                <select asp-for="ContratoId"
                                        class="form-select"
                                        required>
                                    <option value="0">
                                        Selecciona un contrato
                                    </option>

                                    @foreach (var opcion in catalogos.Contratos)
                                    {
                                        <option value="@opcion.Id">
                                            @opcion.Nombre
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="ContratoId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EmpleadoId" class="form-label">
                                    Empleado responsable
                                </label>

                                <select asp-for="EmpleadoId"
                                        class="form-select"
                                        required>
                                    <option value="0">
                                        Selecciona un empleado
                                    </option>

                                    @foreach (var opcion in catalogos.Empleados)
                                    {
                                        <option value="@opcion.Id">
                                            @opcion.Nombre
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="EmpleadoId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tipo" class="form-label">
                                    Tipo de inspección
                                </label>

                                <select asp-for="Tipo"
                                        class="form-select"
                                        required>
                                    <option value="Entrega">Entrega</option>
                                    <option value="Devolución">Devolución</option>
                                </select>

                                <span asp-validation-for="Tipo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Kilometraje" class="form-label">
                                    Kilometraje del vehículo
                                </label>

                                <input asp-for="Kilometraje"
                                       type="number"
                                       min="0"
                                       step="1"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Kilometraje"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NivelCombustible" class="form-label">
                                    Nivel de combustible (%)
                                </label>

                                <input name="NivelCombustible"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01"
                                       value="@Model.NivelCombustible.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="NivelCombustible"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Observaciones" class="form-label">
                                    Observaciones
                                </label>

                                <textarea asp-for="Observaciones"
                                          class="form-control"
                                          maxlength="500"
                                          rows="4"
                                          placeholder="Describe las condiciones del vehículo, daños visibles u otros hallazgos"></textarea>

                                <div class="form-text">
                                    Máximo 500 caracteres.
                                </div>

                                <span asp-validation-for="Observaciones"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 mb-0">
                            La fecha de inspección se registrará automáticamente.
                            Para registrar una devolución debe existir primero
                            una inspección de entrega del mismo contrato.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Inspecciones"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Inspección
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}