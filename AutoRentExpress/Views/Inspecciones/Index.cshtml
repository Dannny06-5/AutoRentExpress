@model List<AutoRentExpress.DTOs.InspeccionDto>

@{
    ViewData["Title"] = "Inspecciones";

    var catalogos = ViewBag.Catalogos as AutoRentExpress.DTOs.InspeccionCatalogosDto
        ?? new AutoRentExpress.DTOs.InspeccionCatalogosDto();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Gestión de Inspecciones</h2>
            <p class="text-muted mb-0">
                Control de las condiciones de entrega y devolución de vehículos
            </p>
        </div>

        <a asp-controller="Inspecciones"
           asp-action="Create"
           class="btn btn-primary">
            + Nueva Inspección
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Exito"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total de inspecciones</h6>
                    <h2 class="fw-bold">@Model.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Inspecciones de entrega</h6>
                    <h2 class="fw-bold text-primary">
                        @Model.Count(i => i.Tipo == "Entrega")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Inspecciones de devolución</h6>
                    <h2 class="fw-bold text-success">
                        @Model.Count(i => i.Tipo == "Devolución")
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Contrato</th>
                            <th>Cliente</th>
                            <th>Vehículo</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Kilometraje</th>
                            <th>Combustible</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var inspeccion in Model)
                        {
                            <tr>
                                <td>@inspeccion.Id</td>

                                <td class="fw-semibold">
                                    @inspeccion.NumeroContrato
                                </td>

                                <td>@inspeccion.NombreCliente</td>

                                <td>@inspeccion.NombreVehiculo</td>

                                <td>
                                    @if (inspeccion.Tipo == "Entrega")
                                    {
                                        <span class="badge bg-primary">
                                            Entrega
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Devolución
                                        </span>
                                    }
                                </td>

                                <td>
                                    @inspeccion.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>@inspeccion.Kilometraje.ToString("N0") km</td>

                                <td>
                                    @inspeccion.NivelCombustible.ToString("0.##")%
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detalleInspeccion-@inspeccion.Id">
                                            Detalles
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editarInspeccion-@inspeccion.Id">
                                            Editar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-center text-muted py-4">
                    Todavía no hay inspecciones registradas.
                </p>
            }
        </div>
    </div>
</div>

@foreach (var inspeccion in Model)
{
    <div class="modal fade"
         id="detalleInspeccion-@inspeccion.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Detalles de la Inspección #@inspeccion.Id
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Contrato</dt>
                        <dd class="col-sm-7">@inspeccion.NumeroContrato</dd>

                        <dt class="col-sm-5">Cliente</dt>
                        <dd class="col-sm-7">@inspeccion.NombreCliente</dd>

                        <dt class="col-sm-5">Vehículo</dt>
                        <dd class="col-sm-7">@inspeccion.NombreVehiculo</dd>

                        <dt class="col-sm-5">Empleado responsable</dt>
                        <dd class="col-sm-7">@inspeccion.NombreEmpleado</dd>

                        <dt class="col-sm-5">Tipo de inspección</dt>
                        <dd class="col-sm-7">@inspeccion.Tipo</dd>

                        <dt class="col-sm-5">Fecha</dt>
                        <dd class="col-sm-7">
                            @inspeccion.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        <dt class="col-sm-5">Kilometraje</dt>
                        <dd class="col-sm-7">
                            @inspeccion.Kilometraje.ToString("N0") km
                        </dd>

                        <dt class="col-sm-5">Combustible</dt>
                        <dd class="col-sm-7">
                            @inspeccion.NivelCombustible.ToString("0.##")%
                        </dd>

                        <dt class="col-sm-5">Observaciones</dt>
                        <dd class="col-sm-7">
                            @(string.IsNullOrWhiteSpace(inspeccion.Observaciones)
                                                    ? "Sin observaciones"
                                                    : inspeccion.Observaciones)
                    </dd>
                </dl>
            </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade"
         id="editarInspeccion-@inspeccion.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        Editar Inspección #@inspeccion.Id
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <form asp-controller="Inspecciones"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="Id"
                           value="@inspeccion.Id" />

                    <input type="hidden"
                           name="ContratoId"
                           value="@inspeccion.ContratoId" />

                    <input type="hidden"
                           name="Tipo"
                           value="@inspeccion.Tipo" />

                    <div class="modal-body p-4">
                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Contrato</label>
                                <input value="@inspeccion.NumeroContrato"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Tipo</label>
                                <input value="@inspeccion.Tipo"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">
                                    Empleado responsable
                                </label>

                                <select name="EmpleadoId"
                                        class="form-select"
                                        required>
                                @foreach (var opcion in catalogos.Empleados)
                                    {
                                        if (opcion.Id == inspeccion.EmpleadoId)
                                        {
                                            <option value="@opcion.Id" selected>
                                                @opcion.Nombre
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@opcion.Id">
                                                @opcion.Nombre
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Kilometraje</label>

                                <input name="Kilometraje"
                                       type="number"
                                       min="0"
                                       step="1"
                                       value="@inspeccion.Kilometraje"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Combustible (%)</label>

                                <input name="NivelCombustible"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01"
                                       value="@inspeccion.NivelCombustible.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observaciones</label>

                                <textarea name="Observaciones"
                                      class="form-control"
                                      rows="4"
                                      maxlength="500">@inspeccion.Observaciones</textarea>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}