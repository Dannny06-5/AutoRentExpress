@model AutoRentExpress.DTOs.InspeccionDto

@{
    ViewData["Title"] = "Editar Inspección";

    var catalogos = ViewBag.Catalogos as AutoRentExpress.DTOs.InspeccionCatalogosDto
        ?? new AutoRentExpress.DTOs.InspeccionCatalogosDto();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Editar Inspección #@Model.Id</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Inspecciones"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ContratoId" type="hidden" />
                        <input asp-for="Tipo" type="hidden" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Contrato</label>

                                <input value="Contrato #@Model.ContratoId"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Tipo</label>

                                <input value="@Model.Tipo"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EmpleadoId" class="form-label">
                                    Empleado responsable
                                </label>

                                <select asp-for="EmpleadoId"
                                        class="form-select"
                                        required>
                                    <option value="0">
                                        Selecciona un empleado
                                    </option>

                                    @foreach (var opcion in catalogos.Empleados)
                                    {
                                        <option value="@opcion.Id">
                                            @opcion.Nombre
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="EmpleadoId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Kilometraje" class="form-label">
                                    Kilometraje
                                </label>

                                <input asp-for="Kilometraje"
                                       type="number"
                                       min="0"
                                       step="1"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Kilometraje"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NivelCombustible" class="form-label">
                                    Combustible (%)
                                </label>

                                <input name="NivelCombustible"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01"
                                       value="@Model.NivelCombustible.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="NivelCombustible"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Observaciones" class="form-label">
                                    Observaciones
                                </label>

                                <textarea asp-for="Observaciones"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"></textarea>

                                <span asp-validation-for="Observaciones"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Inspecciones"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}