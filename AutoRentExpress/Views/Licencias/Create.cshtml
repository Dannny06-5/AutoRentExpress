@model AutoRentExpress.DTOs.LicenciaConducirDto

@{
    ViewData["Title"] = "Nueva Licencia";

    var clientes = ViewBag.Clientes as List<AutoRentExpress.DTOs.LicenciaClienteDto>
        ?? new List<AutoRentExpress.DTOs.LicenciaClienteDto>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Registrar Licencia de Conducir</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Licencias"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="ClienteId" class="form-label">
                                    Cliente
                                </label>

                                <select asp-for="ClienteId"
                                        class="form-select"
                                        required>
                                    <option value="0">Selecciona un cliente</option>

                                    @foreach (var cliente in clientes)
                                    {
                                        <option value="@cliente.Id">
                                            @cliente.Nombre
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="ClienteId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Numero" class="form-label">
                                    Número de licencia
                                </label>

                                <input asp-for="Numero"
                                       class="form-control"
                                       maxlength="40"
                                       required />

                                <span asp-validation-for="Numero"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Categoria" class="form-label">
                                    Categoría
                                </label>

                                <input asp-for="Categoria"
                                       class="form-control"
                                       maxlength="20"
                                       placeholder="Ejemplo: B"
                                       required />

                                <span asp-validation-for="Categoria"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FechaEmision" class="form-label">
                                    Fecha de emisión
                                </label>

                                <input asp-for="FechaEmision"
                                       asp-format="{0:yyyy-MM-dd}"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="FechaEmision"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="FechaVencimiento" class="form-label">
                                    Fecha de vencimiento
                                </label>

                                <input asp-for="FechaVencimiento"
                                       asp-format="{0:yyyy-MM-dd}"
                                       type="date"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="FechaVencimiento"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="PaisEmision" class="form-label">
                                    País de emisión
                                </label>

                                <input asp-for="PaisEmision"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                                <span asp-validation-for="PaisEmision"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 mb-0">
                            La vigencia se calculará a partir de la
                            fecha de vencimiento registrada.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Licencias"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Licencia
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
