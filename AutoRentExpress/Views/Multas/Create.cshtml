@model AutoRentExpress.DTOs.MultaDto

@{
    ViewData["Title"] = "Nueva Multa";

    var contratos = ViewBag.Contratos as List<AutoRentExpress.DTOs.MultaContratoDto>
        ?? new List<AutoRentExpress.DTOs.MultaContratoDto>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Registrar Nueva Multa</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Multas"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="ContratoId" class="form-label">
                                    Contrato
                                </label>

                                <select asp-for="ContratoId"
                                        class="form-select"
                                        required>
                                    <option value="0">Selecciona un contrato</option>

                                    @foreach (var contrato in contratos)
                                    {
                                        <option value="@contrato.Id">
                                            @contrato.NumeroContrato - @contrato.NombreCliente
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="ContratoId"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Motivo" class="form-label">
                                    Motivo de la multa
                                </label>

                                <input asp-for="Motivo"
                                       class="form-control"
                                       maxlength="100"
                                       placeholder="Ejemplo: Retraso en la devolución"
                                       required />

                                <span asp-validation-for="Motivo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Monto" class="form-label">
                                    Monto de la multa ($)
                                </label>

                                <input asp-for="Monto"
                                       type="number"
                                       min="0.01"
                                       max="100000000"
                                       step="0.01"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Monto"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 mb-0">
                            La multa se registrará como pendiente de pago.
                            La fecha se generará automáticamente.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Multas"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Registrar Multa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}