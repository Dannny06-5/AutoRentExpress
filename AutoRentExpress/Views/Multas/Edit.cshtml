@model AutoRentExpress.DTOs.MultaDto

@{
    ViewData["Title"] = "Editar Multa";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Editar Multa</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Multas"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ContratoId" type="hidden" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Contrato</label>

                                <input value="Contrato #@Model.ContratoId"
                                       class="form-control"
                                       readonly />
                            </div>

                            <div class="col-12">
                                <label asp-for="Motivo" class="form-label">
                                    Motivo
                                </label>

                                <input asp-for="Motivo"
                                       class="form-control"
                                       maxlength="100"
                                       required />

                                <span asp-validation-for="Motivo"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Monto" class="form-label">
                                    Monto ($)
                                </label>

                                <input asp-for="Monto"
                                       type="number"
                                       min="0.01"
                                       max="100000000"
                                       step="0.01"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="Monto"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Multas"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}