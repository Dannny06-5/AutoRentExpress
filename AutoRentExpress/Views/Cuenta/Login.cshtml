@model AutoRentExpress.DTOs.LoginDto

@{
    ViewData["Title"] = "Iniciar sesión";
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
}

<style>
    .login-page {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 15px;
        background: linear-gradient(135deg, #eff6ff, #f8fafc);
    }

    .login-card {
        width: 100%;
        max-width: 430px;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 18px 55px rgba(15, 23, 42, .08);
    }

    .login-logo {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: white;
        border-radius: 17px;
        font-size: 28px;
        margin: 0 auto 20px;
    }

    .login-title {
        color: #0f172a;
        font-size: 26px;
        font-weight: 800;
        text-align: center;
    }

    .login-description {
        color: #64748b;
        font-size: 14px;
        text-align: center;
        margin-bottom: 25px;
    }

    .login-card .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
    }

    .login-card .form-control {
        border-radius: 9px;
        padding: 12px;
    }

    .login-card .btn-login {
        width: 100%;
        padding: 12px;
        border-radius: 9px;
        font-weight: 700;
    }
</style>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <i class="bi bi-car-front-fill"></i>
        </div>

        <h1 class="login-title">AutoRent Express</h1>

        <p class="login-description">
            Inicia sesión con tu usuario y contraseña.
        </p>

        <form asp-controller="Cuenta"
              asp-action="Login"
              asp-route-returnUrl="@returnUrl"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Usuario" class="form-label">
                    Usuario
                </label>

                <input asp-for="Usuario"
                       class="form-control"
                       autocomplete="username"
                       placeholder="Ingresa tu usuario" />

                <span asp-validation-for="Usuario"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena" class="form-label">
                    Contraseña
                </label>

                <input asp-for="Contrasena"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Ingresa tu contraseña" />

                <span asp-validation-for="Contrasena"
                      class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Recordarme"
                       class="form-check-input" />

                <label asp-for="Recordarme"
                       class="form-check-label">
                    Mantener sesión iniciada
                </label>
            </div>

            <button type="submit"
                    class="btn btn-primary btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Iniciar sesión
            </button>
        </form>

        <div class="text-center mt-4 text-muted small">
            Acceso exclusivo para personal autorizado
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
