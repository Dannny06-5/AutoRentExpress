
<script>
    (() => {
        const formato = new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD"
        });

        const urlDisponibles = '@Url.Action("Disponibles", "Reservas")';

        function escribir(formulario, selector, valor) {
            const elemento = formulario.querySelector(selector);

            if (elemento) {
                elemento.textContent = valor;
            }
        }

        function obtenerDias(inicio, fin) {
            const fechaInicio = new Date(inicio);
            const fechaFin = new Date(fin);

            if (
                !Number.isFinite(fechaInicio.getTime()) ||
                !Number.isFinite(fechaFin.getTime()) ||
                fechaFin <= fechaInicio
            ) {
                return 0;
            }

            return Math.max(
                1,
                Math.ceil(
                    (fechaFin.getTime() - fechaInicio.getTime()) /
                    86400000
                )
            );
        }

        function calcular(formulario) {
            const vehiculo = formulario.querySelector(".selector-vehiculo");
            const selectorTarifa = formulario.querySelector(".selector-tarifa");
            const seguro = formulario.querySelector(".selector-seguro");
            const inicio = formulario.querySelector(".fecha-inicio");
            const fin = formulario.querySelector(".fecha-fin");
            const idReserva = formulario.querySelector('input[name="Id"]');
            const costoExistente = formulario.querySelector(
                ".seguro-costo-existente"
            );
            const tarifaHistorica = formulario.querySelector(
                ".tarifa-historica"
            );

            if (!vehiculo || !inicio || !fin) {
                return;
            }

            const opcionVehiculo = vehiculo.selectedOptions[0];

            const tarifaNormal = Number(
                opcionVehiculo?.dataset.tarifaNormal ||
                opcionVehiculo?.dataset.tarifa ||
                0
            );

            const idVehiculo = Number(vehiculo.value || 0);
            const reservaExistente = Number(idReserva?.value || 0) > 0;

            let tarifa = tarifaNormal;

            if (
                reservaExistente &&
                tarifaHistorica &&
                idVehiculo === Number(formulario.dataset.vehiculoOriginal)
            ) {
                tarifa = Number(tarifaHistorica.value || 0);
            }

            if (selectorTarifa && selectorTarifa.value) {
                const opcionTarifa = selectorTarifa.selectedOptions[0];

                const precioEspecial = Number(
                    opcionTarifa?.dataset.precio || 0
                );

                if (precioEspecial > 0) {
                    tarifa = precioEspecial;
                }
            }

            const dias = tarifa > 0
                ? obtenerDias(inicio.value, fin.value)
                : 0;

            const subtotalVehiculo = dias * tarifa;

            let subtotalSeguro = 0;

            if (seguro) {
                const opcionSeguro = seguro.selectedOptions[0];

                const precioSeguro = Number(
                    opcionSeguro?.dataset.precio || 0
                );

                subtotalSeguro = dias * precioSeguro;
            } else if (reservaExistente && costoExistente) {
                const diasOriginales = Number(
                    costoExistente.dataset.dias || 0
                );

                const montoOriginal = Number(
                    costoExistente.value || 0
                );

                subtotalSeguro = diasOriginales > 0
                    ? dias * (montoOriginal / diasOriginales)
                    : montoOriginal;
            }

            const total = subtotalVehiculo + subtotalSeguro;

            escribir(
                formulario,
                ".reserva-tarifa",
                formato.format(tarifa)
            );

            escribir(
                formulario,
                ".reserva-dias",
                String(dias)
            );

            escribir(
                formulario,
                ".reserva-subtotal",
                formato.format(subtotalVehiculo)
            );

            escribir(
                formulario,
                ".reserva-seguro",
                formato.format(subtotalSeguro)
            );

            escribir(
                formulario,
                ".reserva-total",
                formato.format(total)
            );
        }

        function mostrarMensaje(formulario, mensaje, tipo) {
            const vehiculo = formulario.querySelector(".selector-vehiculo");

            if (!vehiculo) {
                return;
            }

            let aviso = formulario.querySelector(".aviso-disponibilidad");

            if (!aviso) {
                aviso = document.createElement("div");
                aviso.className = "aviso-disponibilidad small mt-2";
                vehiculo.insertAdjacentElement("afterend", aviso);
            }

            aviso.className =
                "aviso-disponibilidad small mt-2 " +
                (tipo === "error" ? "text-danger" : "text-muted");

            aviso.textContent = mensaje;
            aviso.hidden = !mensaje;
        }

        function actualizarOpciones(
            formulario,
            vehiculos,
            valorAnterior,
            categorias
        ) {
            const selector = formulario.querySelector(".selector-vehiculo");

            selector.replaceChildren();

            selector.add(new Option(
                vehiculos.length > 0
                    ? "Selecciona un vehículo disponible"
                    : "No hay vehículos disponibles",
                "0"
            ));

            vehiculos.forEach(vehiculo => {
                const opcion = new Option(
                    vehiculo.nombre,
                    String(vehiculo.id)
                );

                const precio = Number(vehiculo.tarifaDiaria || 0);

                opcion.dataset.tarifa = String(precio);
                opcion.dataset.tarifaNormal = String(precio);

                opcion.dataset.categoria = String(
                    categorias.get(String(vehiculo.id)) || 0
                );

                selector.add(opcion);
            });

            const existeAnterior = vehiculos.some(
                vehiculo => String(vehiculo.id) === valorAnterior
            );

            selector.value = existeAnterior ? valorAnterior : "0";

            if (vehiculos.length === 0) {
                mostrarMensaje(
                    formulario,
                    "No hay vehículos disponibles para las fechas y sucursal seleccionadas.",
                    "error"
                );
            } else if (valorAnterior !== "0" && !existeAnterior) {
                mostrarMensaje(
                    formulario,
                    "El vehículo anterior no está disponible con estos datos. Selecciona otro.",
                    "error"
                );
            } else {
                mostrarMensaje(formulario, "", "normal");
            }

            selector.dispatchEvent(
                new Event("change", { bubbles: true })
            );

            calcular(formulario);
        }

        function inicializarFormulario(formulario) {
            const selector = formulario.querySelector(".selector-vehiculo");
            const selectorTarifa = formulario.querySelector(".selector-tarifa");
            const seguro = formulario.querySelector(".selector-seguro");
            const inicio = formulario.querySelector(".fecha-inicio");
            const fin = formulario.querySelector(".fecha-fin");
            const sucursal = formulario.querySelector(
                'select[name="SucursalRetiroId"]'
            );
            const idReserva = formulario.querySelector(
                'input[name="Id"]'
            );

            if (!selector || !inicio || !fin || !sucursal) {
                return;
            }

            const categorias = new Map();

            Array.from(selector.options).forEach(opcion => {
                if (Number(opcion.value) > 0) {
                    categorias.set(
                        opcion.value,
                        Number(opcion.dataset.categoria || 0)
                    );
                }
            });

            formulario.dataset.vehiculoOriginal = selector.value;

            let numeroSolicitud = 0;
            let controladorActual = null;

            function restaurarOpciones() {
                selector.replaceChildren(
                    new Option(
                        "Selecciona primero la sucursal y las fechas",
                        "0"
                    )
                );

                selector.value = "0";

                selector.dispatchEvent(
                    new Event("change", { bubbles: true })
                );

                calcular(formulario);
            }

            async function consultarDisponibilidad() {
                numeroSolicitud++;

                const solicitud = numeroSolicitud;

                if (controladorActual) {
                    controladorActual.abort();
                }

                const fechaInicio = new Date(inicio.value);
                const fechaFin = new Date(fin.value);

                const fechasValidas =
                    Number.isFinite(fechaInicio.getTime()) &&
                    Number.isFinite(fechaFin.getTime()) &&
                    fechaInicio < fechaFin;

                if (!fechasValidas || Number(sucursal.value) <= 0) {
                    restaurarOpciones();

                    mostrarMensaje(
                        formulario,
                        "Selecciona una sucursal y un período de alquiler válido.",
                        "normal"
                    );

                    return;
                }

                const valorAnterior = selector.value;

                selector.value = "0";
                calcular(formulario);

                const parametros = new URLSearchParams({
                    fechaInicio: inicio.value,
                    fechaFin: fin.value,
                    sucursalRetiroId: sucursal.value,
                    reservaId: idReserva?.value || "0"
                });

                controladorActual = new AbortController();

                selector.disabled = true;

                mostrarMensaje(
                    formulario,
                    "Consultando vehículos disponibles...",
                    "normal"
                );

                try {
                    const respuesta = await fetch(
                        `${urlDisponibles}?${parametros.toString()}`,
                        {
                            signal: controladorActual.signal,
                            headers: {
                                Accept: "application/json"
                            }
                        }
                    );

                    if (!respuesta.ok) {
                        throw new Error(
                            "No se pudo consultar la disponibilidad."
                        );
                    }

                    const vehiculos = await respuesta.json();

                    if (solicitud !== numeroSolicitud) {
                        return;
                    }

                    actualizarOpciones(
                        formulario,
                        vehiculos,
                        valorAnterior,
                        categorias
                    );
                } catch (error) {
                    if (error.name === "AbortError") {
                        return;
                    }

                    if (solicitud !== numeroSolicitud) {
                        return;
                    }

                    selector.replaceChildren(
                        new Option(
                            "No se pudo consultar la disponibilidad",
                            "0"
                        )
                    );

                    selector.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );

                    mostrarMensaje(
                        formulario,
                        "No fue posible verificar la disponibilidad. Intenta cambiar las fechas nuevamente.",
                        "error"
                    );

                    calcular(formulario);
                } finally {
                    if (solicitud === numeroSolicitud) {
                        selector.disabled = false;
                    }
                }
            }

            const costoExistente = formulario.querySelector(
                ".seguro-costo-existente"
            );

            if (costoExistente) {
                costoExistente.dataset.dias = String(
                    obtenerDias(inicio.defaultValue, fin.defaultValue)
                );
            }

            selector.addEventListener("change", () => {
                calcular(formulario);
            });

            if (selectorTarifa) {
                selectorTarifa.addEventListener("change", () => {
                    calcular(formulario);
                });
            }

            if (seguro) {
                seguro.addEventListener("change", () => {
                    calcular(formulario);
                });
            }

            [inicio, fin, sucursal].forEach(campo => {
                campo.addEventListener(
                    "change",
                    consultarDisponibilidad
                );
            });

            formulario.addEventListener("submit", evento => {
                if (
                    selector.disabled ||
                    Number(selector.value) <= 0
                ) {
                    evento.preventDefault();

                    mostrarMensaje(
                        formulario,
                        "Selecciona un vehículo disponible antes de guardar.",
                        "error"
                    );
                }
            });

            calcular(formulario);
            consultarDisponibilidad();
        }

        function iniciar() {
            document.querySelectorAll(".form-reserva").forEach(
                inicializarFormulario
            );
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", iniciar);
        } else {
            iniciar();
        }
    })();
</script>
