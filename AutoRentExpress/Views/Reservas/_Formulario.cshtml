@model AutoRentExpress.DTOs.ReservaDto

@using System.Globalization
@using System.Text.Json

@{
    var catalogos = ViewBag.Catalogos as AutoRentExpress.DTOs.ReservaCatalogosDto
        ?? new AutoRentExpress.DTOs.ReservaCatalogosDto();

    var editando = Model.Id > 0;
    var accion = editando ? "Edit" : "Create";

    var diasOriginales = Model.FechaFin > Model.FechaInicio
        ? Math.Max(1, (int)Math.Ceiling((Model.FechaFin - Model.FechaInicio).TotalDays))
        : 1;

    var precioHistorico = editando
        ? Math.Max(0m, (Model.TotalEstimado - Model.CostoSeguro) / diasOriginales)
        : 0m;

    var tarifasJson = JsonSerializer.Serialize(catalogos.Tarifas);
}

<form asp-controller="Reservas"
      asp-action="@accion"
      method="post"
      class="form-reserva">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">

        <div class="col-md-6">
            <label asp-for="ClienteId" class="form-label">
                Cliente
            </label>

            <select asp-for="ClienteId" class="form-select" required>
                <option value="0">Selecciona un cliente</option>

                @foreach (var opcion in catalogos.Clientes)
                {
                    <option value="@opcion.Id">@opcion.Nombre</option>
                }
            </select>

            <span asp-validation-for="ClienteId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="VehiculoId" class="form-label">
                Vehículo
            </label>

            <select asp-for="VehiculoId"
                    class="form-select selector-vehiculo"
                    required>
                <option value="0">Selecciona un vehículo</option>

                @foreach (var opcion in catalogos.Vehiculos)
                {
                    <option value="@opcion.Id"
                            data-tarifa="@opcion.TarifaDiaria.ToString(CultureInfo.InvariantCulture)"
                            data-tarifa-normal="@opcion.TarifaDiaria.ToString(CultureInfo.InvariantCulture)"
                            data-categoria="@opcion.CategoriaVehiculoId">
                        @opcion.Nombre
                    </option>
                }
            </select>

            <span asp-validation-for="VehiculoId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="SucursalRetiroId" class="form-label">
                Sucursal de retiro
            </label>

            <select asp-for="SucursalRetiroId"
                    class="form-select"
                    required>
                <option value="0">Selecciona una sucursal</option>

                @foreach (var opcion in catalogos.Sucursales)
                {
                    <option value="@opcion.Id">@opcion.Nombre</option>
                }
            </select>

            <span asp-validation-for="SucursalRetiroId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="SucursalDevolucionId" class="form-label">
                Sucursal de devolución
            </label>

            <select asp-for="SucursalDevolucionId"
                    class="form-select"
                    required>
                <option value="0">Selecciona una sucursal</option>

                @foreach (var opcion in catalogos.Sucursales)
                {
                    <option value="@opcion.Id">@opcion.Nombre</option>
                }
            </select>

            <span asp-validation-for="SucursalDevolucionId"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FechaInicio" class="form-label">
                Fecha y hora de retiro
            </label>

            <input asp-for="FechaInicio"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   type="datetime-local"
                   class="form-control fecha-inicio"
                   required />

            <span asp-validation-for="FechaInicio"
                  class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="FechaFin" class="form-label">
                Fecha y hora de devolución
            </label>

            <input asp-for="FechaFin"
                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                   type="datetime-local"
                   class="form-control fecha-fin"
                   required />

            <span asp-validation-for="FechaFin"
                  class="text-danger"></span>
        </div>

        @if (!editando)
        {
            <div class="col-12">
                <label asp-for="TarifaId"
                       class="form-label fw-semibold">
                    Tarifa del alquiler
                </label>

                <select asp-for="TarifaId"
                        class="form-select selector-tarifa">
                    <option value="">
                        Tarifa normal del vehículo
                    </option>
                </select>

                <div class="form-text">
                    La tarifa normal se aplica por defecto.
                    Puedes seleccionar una tarifa especial vigente
                    si el cliente desea utilizarla.
                </div>

                <span asp-validation-for="TarifaId"
                      class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="SeguroId"
                       class="form-label fw-semibold">
                    Seguro adicional
                </label>

                <select asp-for="SeguroId"
                        class="form-select selector-seguro">
                    <option value="">Sin seguro adicional</option>

                    @foreach (var opcion in catalogos.Seguros)
                    {
                        <option value="@opcion.Id"
                                data-precio="@opcion.TarifaDiaria.ToString(CultureInfo.InvariantCulture)">
                            @opcion.Nombre -
                            $@opcion.TarifaDiaria.ToString("N2") por día
                        </option>
                    }
                </select>

                <div class="form-text">
                    Opcional. El seguro se cobrará por cada día facturable.
                </div>

                <span asp-validation-for="SeguroId"
                      class="text-danger"></span>
            </div>
        }
        else
        {
            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Tarifa del alquiler
                </label>

                <input type="text"
                       class="form-control"
                       value="$@precioHistorico.ToString("N2") por día"
                       readonly />

                <input type="hidden"
                       class="tarifa-historica"
                       value="@precioHistorico.ToString(CultureInfo.InvariantCulture)" />

                <div class="form-text">
                    El precio acordado se conserva al editar esta reserva.
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">
                    Seguro contratado
                </label>

                <input type="text"
                       class="form-control"
                       value="@(string.IsNullOrWhiteSpace(Model.NombreSeguro) ? "Sin seguro adicional" : Model.NombreSeguro)"
                       readonly />

                <input type="hidden"
                       class="seguro-costo-existente"
                       value="@Model.CostoSeguro.ToString(CultureInfo.InvariantCulture)" />

                <div class="form-text">
                    El seguro contratado se conserva al editar.
                    Si cambias las fechas, su importe se ajustará
                    usando el precio diario original.
                </div>
            </div>
        }
    </div>

    <div class="card bg-light border-0 mt-4">
        <div class="card-body">
            <h6 class="fw-bold mb-3">
                Resumen del alquiler
            </h6>

            <div class="d-flex justify-content-between mb-2">
                <span>Tarifa diaria aplicada</span>
                <strong class="reserva-tarifa">$0.00</strong>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span>Días facturables</span>
                <strong class="reserva-dias">0</strong>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal del vehículo</span>
                <strong class="reserva-subtotal">$0.00</strong>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal del seguro</span>
                <strong class="reserva-seguro">$0.00</strong>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold">Total estimado</span>

                <strong class="fs-5 text-primary reserva-total">
                    $0.00
                </strong>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-controller="Reservas"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

        <button type="submit" class="btn btn-primary">
            @(editando ? "Guardar Cambios" : "Registrar Reserva")
        </button>
    </div>
</form>

@if (!editando)
{
    <script>
        (() => {
            const tarifas = @Html.Raw(tarifasJson);

            function inicializarTarifas() {
                const formulario = document.querySelector(".form-reserva");

                if (!formulario) return;

                const vehiculo = formulario.querySelector(".selector-vehiculo");
                const selectorTarifa = formulario.querySelector(".selector-tarifa");
                const inicio = formulario.querySelector(".fecha-inicio");
                const fin = formulario.querySelector(".fecha-fin");

                if (!vehiculo || !selectorTarifa || !inicio || !fin) {
                    return;
                }

                const tarifaInicial = selectorTarifa.value;
                let primeraCarga = true;

                function obtenerFecha(valor) {
                    if (!valor) return null;

                    const fecha = new Date(valor);

                    if (Number.isNaN(fecha.getTime())) {
                        return null;
                    }

                    return fecha;
                }

                function fechaLocal(fecha) {
                    return [
                        fecha.getFullYear(),
                        String(fecha.getMonth() + 1).padStart(2, "0"),
                        String(fecha.getDate()).padStart(2, "0")
                    ].join("-");
                }

                function actualizarTarifas() {
                    const opcionVehiculo =
                        vehiculo.options[vehiculo.selectedIndex];

                    const categoria = Number(
                        opcionVehiculo?.dataset.categoria || 0
                    );

                    const fechaInicio = obtenerFecha(inicio.value);
                    const fechaFin = obtenerFecha(fin.value);

                    const seleccionAnterior = primeraCarga
                        ? tarifaInicial
                        : selectorTarifa.value;

                    primeraCarga = false;

                    selectorTarifa.innerHTML = "";

                    const opcionNormal = document.createElement("option");

                    opcionNormal.value = "";
                    opcionNormal.textContent =
                        "Tarifa normal del vehículo";

                    selectorTarifa.appendChild(opcionNormal);

                    if (!categoria || !fechaInicio || !fechaFin ||
                        fechaFin <= fechaInicio) {
                        selectorTarifa.value = "";
                        selectorTarifa.dispatchEvent(
                            new Event("change", { bubbles: true })
                        );
                        return;
                    }

                    const ultimoDia = new Date(fechaFin);

                    if (
                        ultimoDia.getHours() === 0 &&
                        ultimoDia.getMinutes() === 0 &&
                        ultimoDia.getSeconds() === 0
                    ) {
                        ultimoDia.setDate(ultimoDia.getDate() - 1);
                    }

                    const primerDiaTexto = fechaLocal(fechaInicio);
                    const ultimoDiaTexto = fechaLocal(ultimoDia);

                    tarifas.forEach(t => {
                        if (t.CategoriaVehiculoId !== categoria) {
                            return;
                        }

                        const vigenteDesde =
                            t.VigenteDesde.substring(0, 10);

                        const vigenteHasta = t.VigenteHasta
                            ? t.VigenteHasta.substring(0, 10)
                            : null;

                        if (vigenteDesde > primerDiaTexto) {
                            return;
                        }

                        if (
                            vigenteHasta &&
                            vigenteHasta < ultimoDiaTexto
                        ) {
                            return;
                        }

                        const opcion = document.createElement("option");

                        opcion.value = String(t.Id);
                        opcion.dataset.precio = String(t.PrecioDiario);

                        opcion.textContent =
                            `${t.Nombre} - $${Number(t.PrecioDiario).toFixed(2)} por día`;

                        selectorTarifa.appendChild(opcion);
                    });

                    const existeSeleccion = Array.from(
                        selectorTarifa.options
                    ).some(opcion =>
                        opcion.value === seleccionAnterior
                    );

                    selectorTarifa.value = existeSeleccion
                        ? seleccionAnterior
                        : "";

                    selectorTarifa.dispatchEvent(
                        new Event("change", { bubbles: true })
                    );
                }

                vehiculo.addEventListener("change", actualizarTarifas);
                inicio.addEventListener("change", actualizarTarifas);
                fin.addEventListener("change", actualizarTarifas);

                actualizarTarifas();
            }

            if (document.readyState === "loading") {
                document.addEventListener(
                    "DOMContentLoaded",
                    inicializarTarifas
                );
            } else {
                inicializarTarifas();
            }
        })();
    </script>
}
