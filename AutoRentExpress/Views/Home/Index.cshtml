@model AutoRentExpress.DTOs.DashboardDto

@{
    ViewData["Title"] = "Dashboard";

    var maximoIngresos = Model.IngresosMensuales.Any()
        ? Model.IngresosMensuales.Max(m => m.Total)
        : 0m;

    var totalActividad = Model.ReservasPendientes +
                         Model.ReservasEnCurso +
                         Model.ReservasFinalizadas;

    var porcentajePendientes = totalActividad > 0
        ? Model.ReservasPendientes * 100m / totalActividad
        : 0m;

    var porcentajeCurso = totalActividad > 0
        ? Model.ReservasEnCurso * 100m / totalActividad
        : 0m;

    var porcentajeFinalizadas = totalActividad > 0
        ? Model.ReservasFinalizadas * 100m / totalActividad
        : 0m;
}

<style>
    .dashboard {
        --dashboard-primary: #2563eb;
        --dashboard-soft: #eff6ff;
    }

    .dashboard-header {
        background: linear-gradient(115deg, #172554, #1d4ed8);
        border-radius: 18px;
        padding: 30px;
        color: white;
    }

    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .dashboard-header p {
        color: #dbeafe;
        margin-bottom: 0;
    }

    .dashboard-card {
        background: white;
        border: 1px solid #e9edf4;
        border-radius: 15px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .035);
    }

    .dashboard-card-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 10px;
    }

    .dashboard-card-value {
        color: #0f172a;
        font-size: 28px;
        line-height: 1.2;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .dashboard-card-footer {
        color: #94a3b8;
        font-size: 12px;
    }

    .dashboard-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .dashboard-icon.blue {
        background: #eff6ff;
        color: #2563eb;
    }

    .dashboard-icon.green {
        background: #ecfdf5;
        color: #059669;
    }

    .dashboard-icon.orange {
        background: #fff7ed;
        color: #ea580c;
    }

    .dashboard-icon.purple {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .dashboard-panel {
        background: white;
        border: 1px solid #e9edf4;
        border-radius: 15px;
        padding: 24px;
        height: 100%;
        box-shadow: 0 4px 18px rgba(15, 23, 42, .035);
    }

    .dashboard-panel-title {
        color: #0f172a;
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .dashboard-panel-description {
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 20px;
    }

    .dashboard-chart {
        height: 240px;
        display: flex;
        align-items: end;
        gap: 14px;
        padding-top: 25px;
        border-bottom: 1px solid #e2e8f0;
    }

    .dashboard-chart-column {
        flex: 1;
        height: 100%;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: end;
        gap: 9px;
    }

    .dashboard-chart-value {
        color: #475569;
        font-size: 11px;
        font-weight: 600;
        text-align: center;
    }

    .dashboard-chart-bar-area {
        width: 100%;
        height: 170px;
        display: flex;
        align-items: end;
        justify-content: center;
    }

    .dashboard-chart-bar {
        width: 55%;
        max-width: 54px;
        min-height: 4px;
        background: linear-gradient(180deg, #60a5fa, #2563eb);
        border-radius: 7px 7px 0 0;
        transition: .2s ease;
    }

    .dashboard-chart-bar:hover {
        background: #1d4ed8;
        opacity: .85;
    }

    .dashboard-chart-labels {
        display: flex;
        gap: 14px;
        padding-top: 12px;
    }

    .dashboard-chart-label {
        flex: 1;
        min-width: 0;
        color: #64748b;
        font-size: 11px;
        text-align: center;
    }

    .dashboard-stat-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 11px;
        gap: 10px;
    }

    .dashboard-stat-line span {
        color: #64748b;
        font-size: 13px;
    }

    .dashboard-stat-line strong {
        color: #0f172a;
        font-size: 14px;
    }

    .dashboard-progress {
        height: 8px;
        background: #f1f5f9;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        margin-bottom: 22px;
    }

    .dashboard-progress > div {
        height: 100%;
    }

    .dashboard-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dashboard-table th {
        background: #f8fafc;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        padding: 13px 12px;
        white-space: nowrap;
    }

    .dashboard-table td {
        padding: 14px 12px;
        font-size: 13px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }

    .dashboard-table tr:last-child td {
        border-bottom: 0;
    }

    .dashboard-quick-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px;
        border: 1px solid #e9edf4;
        border-radius: 12px;
        color: #334155;
        text-decoration: none;
        background: #fff;
        transition: .2s ease;
    }

    .dashboard-quick-link:hover {
        border-color: #93c5fd;
        background: #eff6ff;
        color: #1d4ed8;
        transform: translateY(-2px);
    }

    .dashboard-quick-link strong {
        font-size: 13px;
    }

    .dashboard-alert {
        padding: 15px 17px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .dashboard-alert.warning {
        background: #fff7ed;
        color: #9a3412;
    }

    .dashboard-alert.danger {
        background: #fef2f2;
        color: #991b1b;
    }

    .dashboard-alert.success {
        background: #ecfdf5;
        color: #065f46;
    }

    .dashboard-alert strong {
        font-size: 13px;
    }

    .dashboard-alert small {
        font-size: 12px;
    }

    .dashboard-section-heading {
        font-weight: 750;
        font-size: 19px;
        color: #0f172a;
    }

    @@media (max-width: 575px) {
        .dashboard-header {
            padding: 22px;
        }

        .dashboard-header h1 {
            font-size: 23px;
        }

        .dashboard-card-value {
            font-size: 23px;
        }

        .dashboard-panel {
            padding: 17px;
        }

        .dashboard-chart {
            gap: 5px;
        }

        .dashboard-chart-labels {
            gap: 5px;
        }

        .dashboard-chart-label {
            font-size: 9px;
        }

        .dashboard-chart-value {
            font-size: 9px;
        }
    }
</style>

<div class="container-fluid dashboard py-4 px-3 px-lg-4">
    <div class="dashboard-header mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="small text-uppercase mb-2 opacity-75">
                    Panel administrativo
                </div>

                <h1>Bienvenido a AutoRent Express</h1>

                <p>
                    Resumen general de las operaciones de alquiler de vehículos.
                </p>
            </div>

            <div class="text-start text-lg-end">
                <div class="fw-semibold">
                    @DateTime.Today.ToString("dd/MM/yyyy")
                </div>

                <div class="small opacity-75">
                    Información actualizada al cargar
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="dashboard-section-heading mb-0">
            Resumen general
        </h2>

        <span class="small text-muted">
            Datos de SQL Server
        </span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="dashboard-card-label">
                            Vehículos registrados
                        </div>

                        <div class="dashboard-card-value">
                            @Model.TotalVehiculos
                        </div>
                    </div>

                    <div class="dashboard-icon blue">
                        🚘
                    </div>
                </div>

                <div class="dashboard-card-footer">
                    @Model.VehiculosDisponibles disponibles
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="dashboard-card-label">
                            Total de reservas
                        </div>

                        <div class="dashboard-card-value">
                            @Model.TotalReservas
                        </div>
                    </div>

                    <div class="dashboard-icon purple">
                        📅
                    </div>
                </div>

                <div class="dashboard-card-footer">
                    @Model.ReservasPendientes pendientes
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="dashboard-card-label">
                            Contratos registrados
                        </div>

                        <div class="dashboard-card-value">
                            @Model.TotalContratos
                        </div>
                    </div>

                    <div class="dashboard-icon orange">
                        📄
                    </div>
                </div>

                <div class="dashboard-card-footer">
                    @Model.ContratosEnCurso en curso
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="dashboard-card-label">
                            Ingresos recibidos
                        </div>

                        <div class="dashboard-card-value text-success">
                            $@Model.TotalIngresos.ToString("N2")
                        </div>
                    </div>

                    <div class="dashboard-icon green">
                        💰
                    </div>
                </div>

                <div class="dashboard-card-footer">
                    Pagos confirmados
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="dashboard-card-label">
                    Vehículos disponibles
                </div>

                <div class="dashboard-card-value text-primary">
                    @Model.VehiculosDisponibles
                </div>

                <div class="dashboard-card-footer">
                    Listos para reservas
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="dashboard-card-label">
                    Alquileres en curso
                </div>

                <div class="dashboard-card-value">
                    @Model.ContratosEnCurso
                </div>

                <div class="dashboard-card-footer">
                    Contratos activos
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="dashboard-card-label">
                    Ingresos del mes
                </div>

                <div class="dashboard-card-value text-success">
                    $@Model.IngresosMes.ToString("N2")
                </div>

                <div class="dashboard-card-footer">
                    Pagos confirmados este mes
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-card">
                <div class="dashboard-card-label">
                    Saldo pendiente
                </div>

                <div class="dashboard-card-value text-warning">
                    $@Model.SaldoPendiente.ToString("N2")
                </div>

                <div class="dashboard-card-footer">
                    Saldo de contratos registrados
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="dashboard-panel">
                <div class="dashboard-panel-title">
                    Ingresos de los últimos 6 meses
                </div>

                <div class="dashboard-panel-description">
                    Total de pagos confirmados por mes
                </div>

                <div class="dashboard-chart">
                    @foreach (var mes in Model.IngresosMensuales)
                    {
                        var altura = maximoIngresos > 0
                        ? (double)(mes.Total * 100m / maximoIngresos)
                        : 0d;

                        var estiloAltura = "height:" +
                        altura.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) +
                        "%";

                        <div class="dashboard-chart-column">
                            <span class="dashboard-chart-value">
                                $@mes.Total.ToString("N0")
                            </span>

                            <div class="dashboard-chart-bar-area">
                                <div class="dashboard-chart-bar"
                                     style="@estiloAltura"
                                     title="@mes.Mes: $@mes.Total.ToString("N2")">
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="dashboard-chart-labels">
                    @foreach (var mes in Model.IngresosMensuales)
                    {
                        <span class="dashboard-chart-label">
                            @mes.Mes
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dashboard-panel">
                <div class="dashboard-panel-title">
                    Estado de las reservas
                </div>

                <div class="dashboard-panel-description">
                    Distribución de reservas no canceladas
                </div>

                <div class="dashboard-stat-line">
                    <span>Pendientes</span>
                    <strong>@Model.ReservasPendientes</strong>
                </div>

                <div class="dashboard-progress">
                    <div style="width:@porcentajePendientes.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; background:#f59e0b">
                    </div>
                </div>

                <div class="dashboard-stat-line">
                    <span>En curso</span>
                    <strong>@Model.ReservasEnCurso</strong>
                </div>

                <div class="dashboard-progress">
                    <div style="width:@porcentajeCurso.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; background:#2563eb">
                    </div>
                </div>

                <div class="dashboard-stat-line">
                    <span>Finalizadas</span>
                    <strong>@Model.ReservasFinalizadas</strong>
                </div>

                <div class="dashboard-progress">
                    <div style="width:@porcentajeFinalizadas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; background:#10b981">
                    </div>
                </div>

                <div class="d-flex justify-content-between small text-muted mt-4">
                    <span>Total de reservas</span>
                    <strong>@Model.TotalReservas</strong>
                </div>

                <a asp-controller="Reservas"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm w-100 mt-3">
                    Ver todas las reservas
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="dashboard-panel">
                <div class="dashboard-panel-title">
                    Estado de la flota
                </div>

                <div class="dashboard-panel-description">
                    Situación actual de los vehículos activos
                </div>

                <div class="dashboard-stat-line">
                    <span>Disponibles</span>
                    <strong class="text-success">
                        @Model.VehiculosDisponibles
                    </strong>
                </div>

                <div class="dashboard-stat-line">
                    <span>Alquilados</span>
                    <strong class="text-primary">
                        @Model.VehiculosAlquilados
                    </strong>
                </div>

                <div class="dashboard-stat-line">
                    <span>En mantenimiento</span>
                    <strong class="text-warning">
                        @Model.VehiculosMantenimiento
                    </strong>
                </div>

                <hr />

                <a asp-controller="Vehiculos"
                   asp-action="Index"
                   class="btn btn-outline-primary btn-sm">
                    Administrar vehículos
                </a>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-panel">
                <div class="dashboard-panel-title">
                    Alertas administrativas
                </div>

                <div class="dashboard-panel-description">
                    Situaciones que requieren revisión
                </div>

                @if (Model.LicenciasVencidas > 0)
                {
                    <div class="dashboard-alert danger">
                        <div>
                            <strong>
                                Licencias vencidas
                            </strong>

                            <div>
                                <small>
                                    @Model.LicenciasVencidas licencias requieren revisión
                                </small>
                            </div>
                        </div>

                        <a asp-controller="Licencias"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-danger">
                            Revisar
                        </a>
                    </div>
                }

                @if (Model.MantenimientosEnProceso > 0)
                {
                    <div class="dashboard-alert warning">
                        <div>
                            <strong>
                                Mantenimientos activos
                            </strong>

                            <div>
                                <small>
                                    @Model.MantenimientosEnProceso mantenimientos en proceso
                                </small>
                            </div>
                        </div>

                        <a asp-controller="Mantenimientos"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-warning">
                            Revisar
                        </a>
                    </div>
                }

                @if (Model.ContratosPendientes > 0)
                {
                    <div class="dashboard-alert warning">
                        <div>
                            <strong>
                                Entregas pendientes
                            </strong>

                            <div>
                                <small>
                                    @Model.ContratosPendientes contratos pendientes de entrega
                                </small>
                            </div>
                        </div>

                        <a asp-controller="Contratos"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-warning">
                            Revisar
                        </a>
                    </div>
                }

                @if (Model.LicenciasVencidas == 0 &&
                                Model.MantenimientosEnProceso == 0 &&
                                Model.ContratosPendientes == 0)
                {
                    <div class="dashboard-alert success">
                        <div>
                            <strong>
                                Sin alertas registradas
                            </strong>

                            <div>
                                <small>
                                    No hay incidencias en estas categorías.
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="dashboard-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="dashboard-panel-title">
                            Últimos contratos
                        </div>

                        <div class="dashboard-panel-description mb-0">
                            Contratos registrados recientemente
                        </div>
                    </div>

                    <a asp-controller="Contratos"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        Ver todos
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Contrato</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var contrato in Model.UltimosContratos)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @contrato.Numero
                                    </td>

                                    <td>@contrato.Cliente</td>

                                    <td>@contrato.Vehiculo</td>

                                    <td>
                                        @contrato.Fecha.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="fw-semibold">
                                        $@contrato.Total.ToString("N2")
                                    </td>

                                    <td>
                                        @if (contrato.Estado == "Finalizado")
                                        {
                                            <span class="badge bg-success">
                                                Finalizado
                                            </span>
                                        }
                                        else if (contrato.Estado == "En curso")
                                        {
                                            <span class="badge bg-primary">
                                                En curso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @contrato.Estado
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!Model.UltimosContratos.Any())
                            {
                                <tr>
                                    <td colspan="6"
                                        class="text-center text-muted py-4">
                                        Todavía no hay contratos registrados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="dashboard-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="dashboard-panel-title">
                            Últimas reservas
                        </div>

                        <div class="dashboard-panel-description mb-0">
                            Actividad reciente de reservas
                        </div>
                    </div>

                    <a asp-controller="Reservas"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">
                        Ver todas
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Cliente</th>
                                <th>Vehículo</th>
                                <th>Retiro</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var reserva in Model.UltimasReservas)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        #@reserva.Id
                                    </td>

                                    <td>@reserva.Cliente</td>

                                    <td>@reserva.Vehiculo</td>

                                    <td>
                                        @reserva.FechaInicio.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="fw-semibold">
                                        $@reserva.Total.ToString("N2")
                                    </td>

                                    <td>
                                        @if (reserva.Estado == "Finalizada")
                                        {
                                            <span class="badge bg-success">
                                                Finalizada
                                            </span>
                                        }
                                        else if (reserva.Estado == "Cancelada")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelada
                                            </span>
                                        }
                                        else if (reserva.Estado == "En curso")
                                        {
                                            <span class="badge bg-primary">
                                                En curso
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @reserva.Estado
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!Model.UltimasReservas.Any())
                            {
                                <tr>
                                    <td colspan="6"
                                        class="text-center text-muted py-4">
                                        Todavía no hay reservas registradas.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

