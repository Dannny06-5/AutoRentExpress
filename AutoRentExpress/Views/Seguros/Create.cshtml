@model AutoRentExpress.DTOs.SeguroDto

@{
    ViewData["Title"] = "Nuevo Seguro";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Registrar Nuevo Seguro</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-controller="Seguros"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">

                            <div class="col-12">
                                <label asp-for="Nombre" class="form-label">
                                    Nombre del seguro
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       maxlength="100"
                                       placeholder="Ejemplo: Seguro de cobertura total"
                                       required />

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Cobertura" class="form-label">
                                    Cobertura
                                </label>

                                <textarea asp-for="Cobertura"
                                          class="form-control"
                                          rows="4"
                                          maxlength="500"
                                          placeholder="Describe los riesgos y daños cubiertos por el seguro"></textarea>

                                <div class="form-text">
                                    Máximo 500 caracteres.
                                </div>

                                <span asp-validation-for="Cobertura"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CostoDiario" class="form-label">
                                    Costo diario ($)
                                </label>

                                <input name="CostoDiario"
                                       id="CostoDiario"
                                       type="number"
                                       min="0"
                                       max="1000000"
                                       step="0.01"
                                       value="@Model.CostoDiario.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                       class="form-control"
                                       required />

                                <span asp-validation-for="CostoDiario"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4 mb-0">
                            El seguro se registrará como activo.
                            Posteriormente podremos asociarlo a los
                            detalles de las reservas.
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-controller="Seguros"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Guardar Seguro
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}