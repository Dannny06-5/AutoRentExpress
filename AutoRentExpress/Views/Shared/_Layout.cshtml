@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var titulo = ViewData["Title"]?.ToString() ?? "Dashboard";

    var modulosAdicionales = new[]
    {
        new { Controlador = "Pagos", Nombre = "Pagos", Icono = "bi-credit-card" },
        new { Controlador = "Multas", Nombre = "Multas", Icono = "bi-exclamation-triangle" },
        new { Controlador = "Seguros", Nombre = "Seguros", Icono = "bi-shield-check" },
        new { Controlador = "Tarifas", Nombre = "Tarifas", Icono = "bi-tags" },
        new { Controlador = "Mantenimientos", Nombre = "Mantenimientos", Icono = "bi-tools" },
        new { Controlador = "Inspecciones", Nombre = "Inspecciones", Icono = "bi-clipboard-check" },
        new { Controlador = "Licencias", Nombre = "Licencias", Icono = "bi-person-vcard" },
        new { Controlador = "Empleados", Nombre = "Empleados", Icono = "bi-person-badge" },
        new { Controlador = "Sucursales", Nombre = "Sucursales", Icono = "bi-building" },
        new { Controlador = "Marcas", Nombre = "Marcas", Icono = "bi-bookmark" },
        new { Controlador = "Modelos", Nombre = "Modelos", Icono = "bi-car-front" },
        new { Controlador = "CategoriaVehiculo", Nombre = "Categorías", Icono = "bi-grid" },
        new { Controlador = "EstadosVehiculo", Nombre = "Estados de vehículo", Icono = "bi-list-check" }
    };

    var menuAdicionalActivo = modulosAdicionales.Any(m =>
        m.Controlador.Equals(controladorActual, StringComparison.OrdinalIgnoreCase));

    var autenticado = User.Identity?.IsAuthenticated == true;

    var esAdministrador = User.IsInRole("Administrador");
    var esEmpleado = User.IsInRole("Empleado");

    var rolUsuario = esAdministrador
        ? "Administrador"
        : esEmpleado
            ? "Empleado"
            : "Usuario";

    var mostrarBotonLogin = !autenticado &&
        !controladorActual.Equals("Cuenta", StringComparison.OrdinalIgnoreCase);

    var controladorLogo = autenticado ? "Home" : "Cuenta";
    var accionLogo = autenticado ? "Index" : "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@titulo - AutoRent Express</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AutoRentExpress.styles.css"
          asp-append-version="true" />

    <style>
        :root {
            --are-primary: #2563eb;
            --are-dark: #0f172a;
            --are-muted: #64748b;
            --are-background: #f8fafc;
        }

        html {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--are-background);
            color: var(--are-dark);
            display: flex;
            flex-direction: column;
        }

        .are-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 0;
            box-shadow: 0 2px 12px rgba(15, 23, 42, .035);
            position: relative;
            z-index: 1030;
        }

        .are-brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            text-decoration: none;
            color: #0f172a;
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -.4px;
            white-space: nowrap;
        }

            .are-brand:hover {
                color: #1d4ed8;
            }

        .are-brand-icon {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #2563eb, #1e40af);
            color: white;
            border-radius: 12px;
            font-size: 21px;
        }

        .are-brand-name {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

            .are-brand-name small {
                color: var(--are-muted);
                font-weight: 500;
                font-size: 10px;
                letter-spacing: .2px;
                margin-top: 4px;
            }

        .are-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #475569 !important;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 12px !important;
            border-radius: 9px;
            text-decoration: none;
            transition: background .2s, color .2s;
            white-space: nowrap;
        }

            .are-nav-link:hover {
                background: #eff6ff;
                color: #1d4ed8 !important;
            }

            .are-nav-link.active {
                background: #eff6ff;
                color: #1d4ed8 !important;
            }

            .are-nav-link i {
                font-size: 15px;
            }

        .are-dropdown {
            border: 1px solid #e2e8f0;
            border-radius: 13px;
            padding: 8px;
            box-shadow: 0 14px 35px rgba(15, 23, 42, .1);
            min-width: 250px;
            max-height: 70vh;
            overflow-y: auto;
        }

            .are-dropdown .dropdown-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 12px;
                border-radius: 7px;
                color: #475569;
                font-size: 13px;
                font-weight: 500;
            }

                .are-dropdown .dropdown-item:hover,
                .are-dropdown .dropdown-item.active {
                    background: #eff6ff;
                    color: #1d4ed8;
                }

                .are-dropdown .dropdown-item.active {
                    font-weight: 700;
                }

                .are-dropdown .dropdown-item i {
                    width: 18px;
                    text-align: center;
                    font-size: 15px;
                }

        .are-navbar-toggler {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 12px;
        }

            .are-navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
            }

        .are-main {
            flex: 1;
            width: 100%;
            padding-bottom: 40px;
        }

        .are-user-menu {
            border: 1px solid #e2e8f0;
            border-radius: 11px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 12px;
            color: #334155;
        }

        .are-user-icon {
            width: 31px;
            height: 31px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #dbeafe;
            color: #1d4ed8;
            font-size: 16px;
        }

        .are-user-info {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

            .are-user-info strong {
                font-size: 12px;
            }

            .are-user-info small {
                font-size: 10px;
                color: #64748b;
            }

        .are-logout {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 12px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #ffffff;
            color: #b91c1c;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: .2s;
        }

            .are-logout:hover {
                background: #fef2f2;
                border-color: #f87171;
            }

        .are-login {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            background: #2563eb;
            color: #ffffff;
            border-radius: 9px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

            .are-login:hover {
                background: #1d4ed8;
                color: #ffffff;
            }

        .are-footer {
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 20px 0;
            color: #64748b;
            font-size: 12px;
        }

        .are-footer-brand {
            color: #334155;
            font-weight: 700;
        }

        @@media (max-width: 1199.98px) {
            .are-nav-link {
                font-size: 12px;
                padding: 9px !important;
                gap: 5px;
            }

            .are-brand {
                font-size: 16px;
            }
        }

        @@media (max-width: 991.98px) {
            .are-navbar .navbar-collapse {
                padding-top: 15px;
            }

            .are-nav-link {
                width: 100%;
                padding: 12px !important;
                font-size: 14px;
            }

            .are-dropdown {
                border: 0;
                box-shadow: none;
                max-height: none;
                background: #f8fafc;
            }

            .are-user-menu {
                margin-top: 12px;
            }

            .are-logout {
                width: 100%;
                justify-content: center;
                margin-top: 10px;
            }

            .are-login {
                margin-top: 12px;
                width: 100%;
                justify-content: center;
            }

            .are-footer {
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg are-navbar">
            <div class="container-fluid px-3 px-lg-4">

                <a class="are-brand"
                   asp-controller="@controladorLogo"
                   asp-action="@accionLogo">

                    <span class="are-brand-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </span>

                    <span class="are-brand-name">
                        AutoRent Express
                        <small>Gestión de alquiler de vehículos</small>
                    </span>
                </a>

                <button class="navbar-toggler are-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#areNavbar"
                        aria-controls="areNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menú de navegación">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="areNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">

                        @if (autenticado)
                        {
                            <li class="nav-item">
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="nav-link are-nav-link @(controladorActual == "Home" ? "active" : "")">

                                    <i class="bi bi-speedometer2"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Clientes"
                                   asp-action="Index"
                                   class="nav-link are-nav-link @(controladorActual == "Clientes" ? "active" : "")">

                                    <i class="bi bi-people"></i>
                                    Clientes
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Vehiculos"
                                   asp-action="Index"
                                   class="nav-link are-nav-link @(controladorActual == "Vehiculos" ? "active" : "")">

                                    <i class="bi bi-car-front"></i>
                                    Vehículos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Reservas"
                                   asp-action="Index"
                                   class="nav-link are-nav-link @(controladorActual == "Reservas" ? "active" : "")">

                                    <i class="bi bi-calendar-check"></i>
                                    Reservas
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Contratos"
                                   asp-action="Index"
                                   class="nav-link are-nav-link @(controladorActual == "Contratos" ? "active" : "")">

                                    <i class="bi bi-file-earmark-text"></i>
                                    Contratos
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link are-nav-link dropdown-toggle @(menuAdicionalActivo ? "active" : "")"
                                   href="#"
                                   id="areMasModulos"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="bi bi-grid"></i>
                                    Más módulos
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end are-dropdown"
                                    aria-labelledby="areMasModulos">

                                    @foreach (var modulo in modulosAdicionales)
                                    {
                                        <li>
                                            <a asp-controller="@modulo.Controlador"
                                               asp-action="Index"
                                               class="dropdown-item @(controladorActual == modulo.Controlador ? "active" : "")">

                                                <i class="bi @modulo.Icono"></i>
                                                @modulo.Nombre
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <div class="are-user-menu">
                                    <span class="are-user-icon">
                                        <i class="bi bi-person-circle"></i>
                                    </span>

                                    <span class="are-user-info">
                                        <strong>@User.Identity?.Name</strong>
                                        <small>@rolUsuario</small>
                                    </span>
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Cuenta"
                                      asp-action="Logout"
                                      method="post"
                                      class="m-0">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="are-logout">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else if (mostrarBotonLogin)
                        {
                            <li class="nav-item">
                                <a asp-controller="Cuenta"
                                   asp-action="Login"
                                   class="are-login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="are-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="are-footer">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">

                <div>
                    © @DateTime.Today.Year
                    <span class="are-footer-brand">
                        AutoRent Express
                    </span>
                    · Sistema de Gestión de Alquiler de Vehículos
                </div>

                <div>
                    Panel administrativo
                    <span class="mx-2">·</span>
                    Todos los derechos reservados
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
